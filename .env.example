# PastureGen 环境变量示例
#
# 用法：
#   cp .env.example .env
#   # 按需修改后启动： uvicorn app.main:app
#
# 变量名不区分大小写（pydantic-settings 默认行为）。
# 未设置时使用代码中的默认值，见 app/core/config.py。

# ---------------------------------------------------------------------------
# 应用与租户鉴权
# ---------------------------------------------------------------------------
APP_NAME=AI 智能牧场育种平台
API_PREFIX=/api/v1

# 未携带任何凭据的请求归属的租户（单机演示用）
DEFAULT_TENANT_ID=default

# 租户管理端接口（POST/GET /api/v1/tenants）的 X-Admin-Key。
# ⚠️ 生产环境必填；留空时管理端接口一律返回 401。
ADMIN_API_KEY=

# 是否允许在缺少 X-API-Key 时用 X-Tenant-ID 头指定租户。
# ⚠️ 生产环境必须保持 false：该头由客户端完全可控，
#    开启后任何人伪造它即可读写他人租户数据。
#    仅在本地多租户联调时临时开启。
ALLOW_TENANT_HEADER_FALLBACK=false

# ---------------------------------------------------------------------------
# 持久化路径（SQLite）
# ---------------------------------------------------------------------------
SENSOR_DB_PATH=data/sensor.db
TENANT_DB_PATH=data/tenant.db
ALERT_DB_PATH=data/alert.db
PEDIGREE_DB_PATH=data/pedigree.db
PUSH_DEAD_LETTER_DB_PATH=data/push_dead_letter.db

# ---------------------------------------------------------------------------
# 告警与去抖
# ---------------------------------------------------------------------------
# 同类告警冷却窗口（秒），窗口内重复告警被抑制；<=0 表示关闭去抖
ALERT_COOLDOWN_SECONDS=3600
# 每 (租户, 个体, 指标) 保留的近期读数条数，用于发情/分娩趋势基线
ALERT_TREND_WINDOW=50
# 内存中最多跟踪多少个 (租户, 个体, 指标) 实体，超出按插入顺序淘汰最旧
ALERT_TREND_MAX_ENTITIES=10000

# ---------------------------------------------------------------------------
# 通知推送
# ---------------------------------------------------------------------------
# 全局兜底 webhook；留空表示仅使用各租户自行配置的渠道
ALERT_WEBHOOK_URL=
# 全局渠道载荷格式：feishu | generic
ALERT_WEBHOOK_FORMAT=feishu
# 异步推送队列容量与重试策略
ALERT_PUSH_QUEUE_SIZE=1000
ALERT_PUSH_MAX_RETRIES=3
ALERT_PUSH_RETRY_DELAY_SECONDS=1.0

# 死信人工补发：单次发送超时与有界重试
DEAD_LETTER_REPLAY_TIMEOUT_SECONDS=5.0
DEAD_LETTER_REPLAY_MAX_RETRIES=2
DEAD_LETTER_REPLAY_RETRY_DELAY_SECONDS=0.2

# ---------------------------------------------------------------------------
# 设备接入与部署形态
# ---------------------------------------------------------------------------
# cloud | edge
DEPLOYMENT_ROLE=cloud
# 是否注册 mock 适配器（演示/联调用；生产建议关闭）
ENABLE_MOCK_ADAPTERS=true

# 边缘 MQTT 接入（需 pip install -e ".[edge]"）
MQTT_HOST=localhost
MQTT_PORT=1883
EDGE_MQTT_TOPIC=breeding/devices

# ---------------------------------------------------------------------------
# 外部依赖连接串（PostgreSQL / TimescaleDB，当前为预留项）
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://breeding:breeding@localhost:5432/breeding
TIMESCALE_URL=postgresql://breeding:breeding@localhost:5433/sensor
